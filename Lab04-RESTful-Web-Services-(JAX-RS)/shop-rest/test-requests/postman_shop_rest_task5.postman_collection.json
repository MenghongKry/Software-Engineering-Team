              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"etag = \" + \"\\\"1\\\"\", () => pm.expect(pm.response.headers.get(\"etag\")).to.eql(\"\\\"1\\\"\"));",
                  "pm.test(\"cache-control contains \" + \"max-age=60\", () => pm.expect(pm.response.headers.filter(x => x.key.toLowerCase() === \"cache-control\").map(x => x.value).join(\", \")).to.include(\"max-age=60\"));"
