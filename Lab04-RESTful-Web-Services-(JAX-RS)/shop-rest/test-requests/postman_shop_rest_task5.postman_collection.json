  "item": [
    {
      "name": "Pagination",
      "item": [
        {
          "name": "1_GET_page1_size10_links",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"x-total-count = \" + \"33\", () => pm.expect(pm.response.headers.get(\"x-total-count\")).to.eql(\"33\"));",
                  "pm.test(\"link contains \" + \"rel=\\\"prev\\\"\", () => pm.expect(pm.response.headers.filter(x => x.key.toLowerCase() === \"link\").map(x => x.value).join(\", \")).to.include(\"rel=\\\"prev\\\"\"));",
                  "pm.test(\"link contains \" + \"rel=\\\"next\\\"\", () => pm.expect(pm.response.headers.filter(x => x.key.toLowerCase() === \"link\").map(x => x.value).join(\", \")).to.include(\"rel=\\\"next\\\"\"));",
                  "pm.test(\"link contains \" + \"rel=\\\"last\\\"\", () => pm.expect(pm.response.headers.filter(x => x.key.toLowerCase() === \"link\").map(x => x.value).join(\", \")).to.include(\"rel=\\\"last\\\"\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2_GET_last_page_no_next",
