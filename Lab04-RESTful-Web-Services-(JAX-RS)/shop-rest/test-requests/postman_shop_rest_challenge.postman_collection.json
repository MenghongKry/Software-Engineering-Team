  "item": [
    {
      "name": "Place order + idempotency",
      "item": [
        {
          "name": "1_POST_order_201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "7c1e"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lines\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"location contains \" + \"/api/orders/o-1001\", () => pm.expect(pm.response.headers.filter(x => x.key.toLowerCase() === \"location\").map(x => x.value).join(\", \")).to.include(\"/api/orders/o-1001\"));",
                  "pm.test(\"idempotency-replayed = \" + \"false\", () => pm.expect(pm.response.headers.get(\"idempotency-replayed\")).to.eql(\"false\"));",
                  "pm.test(\"link contains \" + \"rel=\\\"pay\\\"\", () => pm.expect(pm.response.headers.filter(x => x.key.toLowerCase() === \"link\").map(x => x.value).join(\", \")).to.include(\"rel=\\\"pay\\\"\"));",
                  "pm.test(\"json.status = \" + \"NEW\", () => pm.expect(String(pm.response.json().status).toLowerCase()).to.eql(\"NEW\".toLowerCase()));"
                ]
              }
            }
          ]
        },
